# Copy to .env.local and fill in from your Supabase project:
#   Dashboard > Project Settings > Data API
# The anon key is designed to be public; row level security is what protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the web build is hosted. Invite links are built from this, so that a link created
# on the phone opens in a browser for someone who does not have the app. Without it the
# app falls back to the current origin on web, and a boardgameshelf:// deep link on Android.
EXPO_PUBLIC_WEB_URL=https://your-deployment.example
